# Supabase · from Project settings → API in your Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by admin/reconciliation jobs, never sent to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# The posted naira rate. Every dollar figure on the site converts with this.
NEXT_PUBLIC_NGN_PER_USD=1550
